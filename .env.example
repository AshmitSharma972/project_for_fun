# Hindsight Cloud or self-hosted API credentials. Never commit a populated .env.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888

# Groq configuration used by Phase 3 and later.
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Next.js frontend. In Docker, the API target is the Compose service name.
INCIDENTMIND_API_BASE_URL=http://api:8000
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

